# Spreadsheet: ambil ID dari URL https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Dari file JSON service account
GOOGLE_CLIENT_EMAIL=nama@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# String acak minimal 32 karakter
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
# Akun developer pertama (dibuat otomatis saat login pertama)
DEVELOPER_EMAIL=dev@contoh.com
DEVELOPER_PASSWORD=ganti-password-ini

# Info yang tampil di halaman Kebijakan Privasi, Syarat, dan Kontak
NEXT_PUBLIC_CONTACT_EMAIL=halo@contoh.com
NEXT_PUBLIC_OPERATOR_NAME=Nama Perusahaan atau Pengelola
NEXT_PUBLIC_OPERATOR_ADDRESS=Alamat lengkap pengelola
